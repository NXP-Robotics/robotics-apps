<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_rviz_bridge</name>
  <version>0.1.0</version>
  <description>Converts px4_msgs DistanceSensor and SensorOpticalFlow into RViz-friendly
    sensor_msgs/Range and visualization_msgs/Marker for 3D visualization.</description>
  <maintainer email="leonardflorin.sfetcu@nxp.com">Leonard Sfetcu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
